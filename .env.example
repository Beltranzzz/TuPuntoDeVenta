# Copia este archivo como .env.local y llena los valores. Guía: SINCRONIZACION.md
# Los 4 primeros los da Firebase al registrar la app web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Tu correo de administrador (el mismo que pusiste en firestore.rules)
VITE_ADMIN_EMAIL=

# Solo para probar el diseño en tu computadora SIN Firebase (únicamente funciona con npm run dev).
# Quita esta línea o ponla en false para probar el inicio de sesión real.
# VITE_DISABLE_AUTH=true
