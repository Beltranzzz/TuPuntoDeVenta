rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1) CAMBIA este correo por el tuyo (el administrador) antes de publicar las reglas
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'luisxdpollo@gmail.com';
    }

    // Cliente con correo autorizado, activo y con el pago vigente
    function isSubscriber() {
      let a = get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email.lower()));
      return a.data.status == 'active' && a.data.paidUntil > request.time;
    }

    // Lista de correos autorizados: solo el administrador la modifica;
    // cada cliente solo puede ver su propio registro
    match /allowedEmails/{email} {
      allow read: if isAdmin()
        || (request.auth != null && email == request.auth.token.email.lower());
      allow write: if isAdmin();
    }

    // Datos de cada negocio: solo su dueño, con correo verificado y suscripción vigente
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && (isAdmin() || isSubscriber());
    }
  }
}
